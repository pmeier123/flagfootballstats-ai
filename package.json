{
  "name": "flagfootballstats",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "scripts"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -w @ffs/core && npm run typecheck -w @ffs/web",
    "test": "vitest run",
    "build": "npm run build -w @ffs/web",
    "dev": "npm run dev -w @ffs/web",
    "bundle:export": "node scripts/bundle-export-function.mjs",
    "e2e": "npm run e2e -w @ffs/web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  }
}
